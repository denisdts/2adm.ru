# Конфиг чекера. Лежит рядом с бинарником: /opt/2adm-checker/checker.env
# Переменные окружения имеют приоритет над файлом.

# Уникальный GUID чекера. Если пусто, install.sh сгенерирует его при установке,
# а при ручном запуске чекер создаст файл checker.guid рядом с бинарником.
CHECKER_GUID=

# Адрес панели мониторинга
MONITOR_BASE_URL=http://127.0.0.1:7060

# Глобальный API-ключ чекера (обязателен)
MONITOR_API_KEY=

# Как часто опрашивать сервисы
CHECK_INTERVAL=60s

# Таймаут HTTP-проверки и whois/rdap
CHECK_TIMEOUT=10s

# Сколько сервисов проверять одновременно
CHECK_CONCURRENCY=5

# Сбор SSL-сертификатов
CHECK_SSL=true

# Сбор данных о домене (whois/rdap)
CHECK_DOMAIN=true

# Как часто перепроверять домен
CHECK_DOMAIN_INTERVAL=24h

# Имя чекера в heartbeat
CHECKER_NAME=site-checker

# User-Agent запросов
CHECK_USER_AGENT=2adm-checker/1.0
